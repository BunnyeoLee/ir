rules_version = '2';

// 모의창업 IR 펀딩 · Firestore 보안 규칙
// Firebase 콘솔 › Firestore Database › 규칙 탭에 전체를 붙여넣고 [게시]를 누르세요.

service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 관리자 계정 (소문자). 아이디 admin 은 admin@irfund.firebaseapp.com 으로 로그인돼요.
    //   firebase-config.js 의 ADMIN_EMAILS 와 같게 맞추세요.
    function adminEmails() {
      return ['admin@irfund.firebaseapp.com', 'bnlee0525@gmail.com'];
    }

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email', '').lower() in adminEmails()
        && (request.auth.token.get('email_verified', false) == true
            || request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password');
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function cfgPath() { return /databases/$(database)/documents/config/main; }
    function cfg() { return get(cfgPath()).data; }
    function resultsPublic() {
      return exists(cfgPath())
        && (cfg().get('showLive', true) == true || cfg().get('status', '') == 'revealed');
    }

    // 행사 설정 · 팀/발표자료: 누구나 읽고, 관리자만 쓴다
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학생 화면용 집계와 마감 결과: 금액 공개 중이거나 발표 후에만 학생이 읽는다
    match /public/{id} {
      allow read: if isAdmin() || (signedIn() && resultsPublic());
      allow write: if isAdmin();
    }
    match /results/{id} {
      allow read: if isAdmin() || (signedIn() && resultsPublic());
      allow write: if isAdmin();
    }

    // 학생 명단: 관리자가 등록. 학생은 자기 학번으로 로그인한 동안 자기 것만 읽는다
    function ownsSid(sid) {
      return signedIn()
        && exists(/databases/$(database)/documents/claims/$(sid))
        && get(/databases/$(database)/documents/claims/$(sid)).data.uid == request.auth.uid;
    }
    match /students/{sid} {
      allow get: if isAdmin() || ownsSid(sid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 학생 로그인: 이름(아이디)과 학번(비밀번호)이 명단과 맞아야 이 기기로 로그인된다.
    // 다른 기기에서 다시 로그인하면 그 기기로 옮겨 간다.
    match /claims/{sid} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/students/$(sid))
        && request.resource.data.name == get(/databases/$(database)/documents/students/$(sid)).data.nameKey;
      allow delete: if isAdmin();
    }

    // 투자 기록: 학번마다 문서 하나. 그 학번으로 로그인한 기기만, 펀딩 진행 중에만 쓴다.
    match /investments/{sid} {
      allow read: if isAdmin() || ownsSid(sid);
      allow create, update: if ownsSid(sid) && validInvestment(sid);
      allow delete: if isAdmin();
    }
    function validInvestment(sid) {
      let d = request.resource.data;
      let st = get(/databases/$(database)/documents/students/$(sid)).data;
      return exists(cfgPath()) && cfg().get('status', '') == 'open'
        && d.keys().hasOnly(['cohortId', 'ownTeamId', 'alloc', 'updatedAt'])
        && d.alloc is map && d.alloc.size() <= 100
        && d.cohortId == st.cohortId
        && d.ownTeamId == st.ownTeamId
        && !(d.ownTeamId in d.alloc);
    }
  }
}
